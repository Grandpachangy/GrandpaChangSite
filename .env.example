TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Optional -- powers the "now playing" widget. Omit both and the widget
# simply never appears. Create a key at https://www.last.fm/api/account/create
LASTFM_USER=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# Optional -- Web Scrobbler's webhook posts playback events here, which is the
# pause signal Last.fm has no way to express. Without both the key and a KV
# store the now-playing widget behaves exactly as it does otherwise.
#
# Generate with: openssl rand -hex 24
# Then in Web Scrobbler: Settings -> Accounts -> Add Webhook, using
#   https://<your-domain>/api/scrobbler-hook?key=<SCROBBLER_HOOK_KEY>
#
# Note that Web Scrobbler can only be given a URL, so this key travels in the
# query string and is written to Vercel's request logs. Treat it as
# log-exposed rather than secret, and rotate it if those logs are ever shared.
# The endpoint also accepts it as an x-scrobbler-key header for anything able
# to send one. Worst case if it leaks is someone setting the play state on the
# now-playing card.
SCROBBLER_HOOK_KEY=a_long_random_string
# KV_REST_API_URL / KV_REST_API_TOKEN are injected by Vercel's KV integration.
