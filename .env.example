TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Optional -- powers the "now playing" widget. Omit both and the widget
# simply never appears. Create a key at https://www.last.fm/api/account/create
LASTFM_USER=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# Optional -- lets the browser playing the music report pause/resume, which
# Last.fm has no way to express. Without both of these the now-playing widget
# behaves exactly as it does otherwise, so leaving them unset costs nothing.
#
# PLAYSTATE_TOKEN is a shared secret between Vercel and the userscript in
# tools/. Generate one with: openssl rand -hex 24
# The KV_REST_API_* pair is injected automatically by Vercel's KV/Upstash
# integration -- create the store in the dashboard rather than setting these
# by hand.
PLAYSTATE_TOKEN=a_long_random_string
# KV_REST_API_URL=injected_by_vercel
# KV_REST_API_TOKEN=injected_by_vercel
